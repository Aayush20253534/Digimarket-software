// DigiMarket Module 3: identity, RBAC, MFA and revocable sessions on the Module 2 foundation.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum ApprovalCategory {
  GENERAL
  FINANCE
  CONTENT
  DELIVERABLE
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
enum ApprovalOutcome {
  APPROVED
  REJECTED
  CANCELLED
}

enum InvoiceStatus {
 DRAFT
 ISSUED
 VOID
}
enum PaymentStatus {
 PENDING
 VERIFIED
 REJECTED
}
enum BillingFrequency {
 MONTHLY
 QUARTERLY
 YEARLY
}
enum FinanceKind {
  INCOME
  EXPENSE
}
enum FinanceStatus {
  PENDING
  POSTED
  REJECTED
  CANCELLED
}
enum FinanceMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}
enum LeadActivityKind {
  CREATED
  NOTE
  STAGE_CHANGED
  OWNER_ASSIGNED
  FOLLOW_UP_SET
  DETAILS_UPDATED
  DUPLICATE_REVIEWED
}
enum LeadDuplicateResolution {
  OPEN
  CONFIRMED
  DISMISSED
}
enum ClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}
enum ClientServiceStatus {
  ACTIVE
  PAUSED
  ENDED
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELLED
}
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}
enum ContentStatus {
  IDEA
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  CANCELLED
}
enum ContentPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  YOUTUBE
  GOOGLE_BUSINESS
  WEBSITE
  OTHER
}
enum ContentFormat {
  REEL
  POST
  STORY
  CAROUSEL
  VIDEO
  BLOG
  OTHER
}
enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}
enum ProjectMemberRole {
  MANAGER
  CONTRIBUTOR
  REVIEWER
}
enum MilestoneStatus {
  OPEN
  DONE
}
enum DeliverableStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}
enum AssetStatus {
  ACTIVE
  ARCHIVED
}
enum AssetUploadState {
  PENDING
  CONFIRMED
}
enum AssetResourceType {
  IMAGE
  VIDEO
  RAW
}

model Organization {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(160)
  timezone        String           @default("Asia/Kolkata") @db.VarChar(80)
  defaultCurrency String           @default("INR") @db.VarChar(3)
  settingsVersion Int @default(1)
  billingSettings OrganizationBillingSettings?
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  users           User[]
  personalNotes   PersonalNote[]
  roles           Role[]
  teams           Team[]
  founderProfiles FounderProfile[]
  auditLogs       AuditLog[]
  outboxEvents    OutboxEvent[]
  notifications Notification[]
  approvalPolicies ApprovalPolicy[]
  approvalRequests ApprovalRequest[]
  financialCategories FinancialCategory[]
  financialEntries FinancialTransaction[]
  invoiceCounter InvoiceCounter?
  invoices Invoice[]
  payments Payment[]
  billingSchedules BillingSchedule[]
  costAllocations CostAllocation[]
  revenueRecognitions RevenueRecognition[]
  leads Lead[]
  leadDuplicateCandidates LeadDuplicateCandidate[]
  clients Client[]
  assets Asset[]
  assetUploadIntents AssetUploadIntent[]
  projects Project[]
  contentPosts ContentPost[]
  tasks Task[]
  taskRecurrences TaskRecurrence[]
}

model User {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  loginId            String          @db.VarChar(80)
  displayName        String          @db.VarChar(160)
  email              String?         @db.VarChar(255)
  passwordHash       String?         @db.Text
  status             UserStatus      @default(INVITED)
  mustChangePassword Boolean         @default(true)
  authVersion        Int             @default(1)
  mfaSecretEncrypted String?         @db.Text
  mfaPendingEncrypted String?        @db.Text
  mfaPendingExpiresAt DateTime?      @db.Timestamptz(6)
  lastMfaStep        Int?
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles              UserRole[]
  sessions           Session[]
  personalNotes      PersonalNote[]
  teamMemberships    TeamMember[]
  founderProfile     FounderProfile?
  auditActions       AuditLog[]      @relation("AuditActor")
  approvalSubmissions ApprovalRequest[] @relation("ApprovalRequester")
  approvalActions ApprovalDecision[] @relation("ApprovalActor")
  financialEntries FinancialTransaction[] @relation("FinancialSubmitter")
  invoicesCreated Invoice[] @relation("InvoiceCreator")
  invoicesIssued Invoice[] @relation("InvoiceIssuer")
  paymentsRecorded Payment[] @relation("PaymentRecorder")
  paymentsVerified Payment[] @relation("PaymentVerifier")
  billingSchedulesCreated BillingSchedule[]
  revenueRecognitionsCreated RevenueRecognition[]

  leadsCreated Lead[] @relation("LeadCreator")
  leadsAssigned Lead[] @relation("LeadAssignee")
  leadActivities LeadActivity[] @relation("LeadActivityActor")
  reviewedLeadDuplicates LeadDuplicateCandidate[] @relation("LeadDuplicateReviewer")
  clientsCreated Client[] @relation("ClientCreator")
  assetsCreated Asset[] @relation("AssetCreator")
  assetIntentsCreated AssetUploadIntent[] @relation("AssetIntentCreator")
  projectsCreated Project[] @relation("ProjectCreator")
  projectMemberships ProjectMember[]
  contentCreated ContentPost[] @relation("ContentCreator")
  contentOwned ContentPost[] @relation("ContentOwner")
  contentPublished ContentPost[] @relation("ContentPublisher")
  tasksCreated Task[] @relation("TaskCreator")
  assignedTasks TaskAssignment[]
  taskComments TaskComment[]
  notifications Notification[]
  taskRecurrencesCreated TaskRecurrence[]

  @@unique([organizationId, loginId])
  @@index([organizationId, status])
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  key            String           @db.VarChar(80)
  label          String           @db.VarChar(160)
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users          UserRole[]
  permissions    RolePermission[]

  @@unique([organizationId, key])
}

model Permission {
  key         String           @id @db.VarChar(120)
  description String           @db.VarChar(255)
  roles       RolePermission[]
}

model UserRole {
  userId     String @db.Uuid
  roleId     String @db.Uuid
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId        String     @db.Uuid
  permissionKey String     @db.VarChar(120)
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(255)
  previousRefreshTokenHash String? @db.VarChar(255)
  mfaVerifiedAt    DateTime? @db.Timestamptz(6)
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  lastUsedAt       DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  deviceLabel      String?   @db.VarChar(160)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Team {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String        @db.VarChar(160)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members        TeamMember[]

  @@unique([organizationId, name])
}

model TeamMember {
  teamId String @db.Uuid
  userId String @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model FounderProfile {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  userId           String?       @unique @db.Uuid
  displayName      String        @db.VarChar(160)
  title            String        @db.VarChar(160)
  responsibilities String        @db.Text
  sortOrder        Int           @default(0)
  version          Int           @default(1)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, sortOrder])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String?      @db.Uuid
  action         String       @db.VarChar(120)
  entityType     String       @db.VarChar(120)
  entityId       String       @db.VarChar(160)
  requestId      String?      @db.VarChar(160)
  beforeRedacted Json?
  afterRedacted  Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  eventKey       String?      @db.VarChar(160)
  kind           String       @db.VarChar(120)
  aggregateType  String       @db.VarChar(120)
  aggregateId    String       @db.VarChar(160)
  payloadMinimal Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @db.Timestamptz(6)
  publishedAt    DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, eventKey])
  @@index([status, availableAt])
  @@index([organizationId, createdAt])
}

model ApprovalPolicy {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  category         ApprovalCategory
  name             String           @db.VarChar(160)
  approverRoleKeys String[]         @default([])
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requests         ApprovalRequest[]
  @@unique([organizationId, category])
  @@index([organizationId, active])
}

model ApprovalRequest {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  policyId         String           @db.Uuid
  requesterId      String           @db.Uuid
  title            String           @db.VarChar(180)
  description      String           @db.Text
  referenceType    String?          @db.VarChar(80)
  referenceId      String?          @db.VarChar(160)
  status           ApprovalStatus   @default(PENDING)
  approverRoleKeys String[]         @default([])
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  decidedAt        DateTime?        @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policy           ApprovalPolicy   @relation(fields: [policyId], references: [id], onDelete: Restrict)
  requester        User             @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  decision         ApprovalDecision?
  financeEntry     FinancialTransaction?
  projectDeliverable ProjectDeliverable? @relation("DeliverableCurrentApproval")
  contentPost ContentPost? @relation("ContentCurrentApproval")
  @@index([organizationId, status, createdAt])
  @@index([organizationId, requesterId, createdAt])
}

model ApprovalDecision {
  id        String          @id @default(uuid()) @db.Uuid
  requestId String          @unique @db.Uuid
  actorId   String          @db.Uuid
  outcome   ApprovalOutcome
  reason    String?         @db.VarChar(1000)
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor     User            @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([actorId, createdAt])
}

model FinancialCategory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  kind           FinanceKind
  name           String @db.VarChar(120)
  normalizedName String @db.VarChar(120)
  active         Boolean @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries        FinancialTransaction[]
  paymentEntries Payment[]
  @@unique([organizationId, kind, normalizedName])
  @@index([organizationId, kind, active])
}

model FinancialTransaction {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String @db.Uuid
  enteredById       String @db.Uuid
  categoryId        String @db.Uuid
  approvalRequestId String @unique @db.Uuid
  idempotencyKey    String @db.Uuid
  kind              FinanceKind
  amount            Decimal @db.Decimal(19,4)
  currencyCode      String @db.VarChar(3)
  occurredOn        DateTime @db.Date
  merchantOrSource  String? @db.VarChar(160)
  method            FinanceMethod
  description       String? @db.VarChar(2000)
  status            FinanceStatus @default(PENDING)
  postedAt          DateTime? @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  enteredBy         User @relation("FinancialSubmitter", fields: [enteredById], references: [id], onDelete: Restrict)
  category          FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  verifiedPayment   Payment? @relation("PaymentLedgerEntry")
  costAllocationVersion Int @default(0)
  costAllocations CostAllocation[]
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, kind, occurredOn])
  @@index([organizationId, enteredById, createdAt])
}

model Lead {
  id                String      @id @default(uuid()) @db.Uuid
  organizationId    String      @db.Uuid
  businessName      String      @db.VarChar(180)
  normalizedBusinessName String @db.VarChar(180)
  contactName       String?     @db.VarChar(160)
  phone             String?     @db.VarChar(40)
  normalizedPhone   String?     @db.VarChar(20)
  businessType      String?     @db.VarChar(120)
  location          String?     @db.VarChar(240)
  websiteUrl        String?     @db.VarChar(500)
  instagramUrl      String?     @db.VarChar(500)
  source            String?     @db.VarChar(120)
  status            LeadStage   @default(NEW)
  assignedToId      String?     @db.Uuid
  createdById       String      @db.Uuid
  nextFollowUpAt    DateTime?   @db.Timestamptz(6)
  importKey         String?     @db.Uuid
  version           Int         @default(1)
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(6)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator           User        @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee          User?       @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  activities        LeadActivity[]
  duplicateMatches  LeadDuplicateCandidate[] @relation("LeadDuplicateSource")
  duplicateCandidates LeadDuplicateCandidate[] @relation("LeadDuplicateMatch")
  convertedClient Client? @relation("ClientSourceLead")
  @@unique([organizationId, importKey])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, assignedToId, nextFollowUpAt])
  @@index([organizationId, normalizedPhone])
  @@index([organizationId, normalizedBusinessName])
}

model LeadActivity {
  id        String  @id @default(uuid()) @db.Uuid
  leadId    String  @db.Uuid
  actorId   String  @db.Uuid
  kind      LeadActivityKind
  note      String? @db.VarChar(2000)
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  actor     User @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([leadId, createdAt])
}

model LeadDuplicateCandidate {
  id            String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  leadId        String @db.Uuid
  candidateId   String @db.Uuid
  reason        String @db.VarChar(80)
  resolution    LeadDuplicateResolution @default(OPEN)
  resolvedById  String? @db.Uuid
  resolvedAt    DateTime? @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead          Lead @relation("LeadDuplicateSource", fields: [leadId], references: [id], onDelete: Restrict)
  candidate     Lead @relation("LeadDuplicateMatch", fields: [candidateId], references: [id], onDelete: Restrict)
  reviewer      User? @relation("LeadDuplicateReviewer", fields: [resolvedById], references: [id], onDelete: Restrict)
  @@unique([organizationId, leadId, candidateId])
  @@index([organizationId, resolution, createdAt])
}

model Client {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  sourceLeadId String? @unique @db.Uuid
  createdById String @db.Uuid
  businessName String @db.VarChar(180)
  businessType String? @db.VarChar(120)
  phone String? @db.VarChar(40)
  email String? @db.VarChar(255)
  location String? @db.VarChar(240)
  websiteUrl String? @db.VarChar(500)
  instagramUrl String? @db.VarChar(500)
  facebookUrl String? @db.VarChar(500)
  notes String? @db.VarChar(2000)
  status ClientStatus @default(ACTIVE)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator User @relation("ClientCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sourceLead Lead? @relation("ClientSourceLead", fields: [sourceLeadId], references: [id], onDelete: Restrict)
  contacts ClientContact[]
  services ClientService[]
  assets Asset[]
  assetUploadIntents AssetUploadIntent[]
  projects Project[]
  contentPosts ContentPost[]
  invoices Invoice[]
  payments Payment[]
  billingSchedules BillingSchedule[]
  costAllocations CostAllocation[]
  revenueRecognitions RevenueRecognition[]
  @@index([organizationId,status,updatedAt])
  @@index([organizationId,businessName])
}

model ClientContact {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  name String @db.VarChar(160)
  role String? @db.VarChar(120)
  phone String? @db.VarChar(40)
  email String? @db.VarChar(255)
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  @@index([clientId,createdAt])
}

model ClientService {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  name String @db.VarChar(120)
  description String? @db.VarChar(1000)
  status ClientServiceStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  @@index([clientId,status])
}

model AssetUploadIntent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  createdById String @db.Uuid
  clientId String? @db.Uuid
  publicId String @unique @db.VarChar(255)
  filename String @db.VarChar(180)
  contentType String @db.VarChar(100)
  resourceType AssetResourceType
  expectedBytes Int
  status AssetUploadState @default(PENDING)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator User @relation("AssetIntentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  asset Asset?
  @@index([organizationId,expiresAt,status])
}

model Asset {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  uploadedById String @db.Uuid
  clientId String? @db.Uuid
  uploadIntentId String @unique @db.Uuid
  providerAssetId String @unique @db.VarChar(120)
  publicId String @unique @db.VarChar(255)
  filename String @db.VarChar(180)
  contentType String @db.VarChar(100)
  resourceType AssetResourceType
  format String @db.VarChar(16)
  bytes Int
  status AssetStatus @default(ACTIVE)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploader User @relation("AssetCreator", fields: [uploadedById], references: [id], onDelete: Restrict)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  uploadIntent AssetUploadIntent @relation(fields: [uploadIntentId], references: [id], onDelete: Restrict)
  projectDeliverables ProjectDeliverable[]
  contentPostAssets ContentPostAsset[]
  @@index([organizationId,status,createdAt])
  @@index([organizationId,clientId,createdAt])
  @@index([organizationId,filename])
}

 
// Module 10: client-linked delivery management with membership-scoped reads.
model Project {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  clientId String @db.Uuid
  createdById String @db.Uuid
  name String @db.VarChar(180)
  description String? @db.VarChar(2000)
  status ProjectStatus @default(PLANNED)
  startOn DateTime? @db.Date
  dueOn DateTime? @db.Date
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Restrict)
  client Client @relation(fields:[clientId], references:[id], onDelete:Restrict)
  creator User @relation("ProjectCreator", fields:[createdById], references:[id], onDelete:Restrict)
  members ProjectMember[]
  milestones ProjectMilestone[]
  deliverables ProjectDeliverable[]
  tasks Task[]
  taskRecurrences TaskRecurrence[]
  contentPosts ContentPost[]
  costAllocations CostAllocation[]
  @@index([organizationId,status,updatedAt])
  @@index([organizationId,clientId,createdAt])
}

model ProjectMember {
  projectId String @db.Uuid
  userId String @db.Uuid
  role ProjectMemberRole @default(CONTRIBUTOR)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  project Project @relation(fields:[projectId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  @@id([projectId,userId])
  @@index([userId])
}

model ProjectMilestone {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  title String @db.VarChar(180)
  dueOn DateTime? @db.Date
  status MilestoneStatus @default(OPEN)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  project Project @relation(fields:[projectId], references:[id], onDelete:Restrict)
  deliverables ProjectDeliverable[]
  @@index([projectId,status,dueOn])
}

model ProjectDeliverable {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  milestoneId String? @db.Uuid
  assetId String? @db.Uuid
  approvalRequestId String? @unique @db.Uuid
  title String @db.VarChar(180)
  description String? @db.VarChar(2000)
  status DeliverableStatus @default(DRAFT)
  version Int @default(1)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  project Project @relation(fields:[projectId], references:[id], onDelete:Restrict)
  milestone ProjectMilestone? @relation(fields:[milestoneId], references:[id], onDelete:Restrict)
  asset Asset? @relation(fields:[assetId], references:[id], onDelete:Restrict)
  approvalRequest ApprovalRequest? @relation("DeliverableCurrentApproval", fields:[approvalRequestId], references:[id], onDelete:Restrict)
  @@index([projectId,status,updatedAt])
  @@index([milestoneId])
  @@index([assetId])
}

// Module 11: assignable tasks, checklists, comments and durable recurrence cursor.
// BullMQ is a wakeup mechanism only; the database constraints provide exactly-once occurrence creation.
model Task {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  projectId String? @db.Uuid
  createdById String @db.Uuid
  recurrenceId String? @db.Uuid
  scheduledFor DateTime? @db.Timestamptz(6)
  title String @db.VarChar(180)
  description String? @db.VarChar(2000)
  priority TaskPriority @default(MEDIUM)
  status TaskStatus @default(TODO)
  dueAt DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  project Project? @relation(fields:[projectId],references:[id],onDelete:Restrict)
  creator User @relation("TaskCreator",fields:[createdById],references:[id],onDelete:Restrict)
  recurrence TaskRecurrence? @relation(fields:[recurrenceId],references:[id],onDelete:Restrict)
  assignees TaskAssignment[]
  checklist TaskChecklistItem[]
  comments TaskComment[]
  @@unique([recurrenceId,scheduledFor])
  @@index([organizationId,status,dueAt])
  @@index([organizationId,createdAt,id])
  @@index([projectId,status])
}

model TaskAssignment {
  taskId String @db.Uuid
  userId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  @@id([taskId,userId])
  @@index([userId,taskId])
}

model TaskChecklistItem {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  label String @db.VarChar(240)
  completed Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
  @@index([taskId,createdAt])
}

model TaskComment {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  authorId String @db.Uuid
  body String @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
  author User @relation(fields:[authorId],references:[id],onDelete:Restrict)
  @@index([taskId,createdAt])
}

model TaskRecurrence {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  projectId String? @db.Uuid
  createdById String @db.Uuid
  title String @db.VarChar(180)
  description String? @db.VarChar(2000)
  priority TaskPriority @default(MEDIUM)
  assigneeIds String[] @db.Uuid
  frequency RecurrenceFrequency
  interval Int @default(1)
  timezone String @db.VarChar(80)
  anchorAt DateTime @db.Timestamptz(6)
  nextRunAt DateTime @db.Timestamptz(6)
  dueOffsetDays Int @default(0)
  enabled Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  project Project? @relation(fields:[projectId],references:[id],onDelete:Restrict)
  creator User @relation(fields:[createdById],references:[id],onDelete:Restrict)
  occurrences Task[]
  @@index([enabled,nextRunAt])
  @@index([organizationId,createdAt])
}

// Module 12: client-specific content workflow with immutable snapshots per revision.
model ContentPost {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  clientId String @db.Uuid
  projectId String? @db.Uuid
  createdById String @db.Uuid
  ownerId String @db.Uuid
  publishedById String? @db.Uuid
  approvalRequestId String? @unique @db.Uuid
  title String @db.VarChar(180)
  caption String @db.Text
  hashtags String[] @default([])
  platform ContentPlatform
  format ContentFormat
  status ContentStatus @default(IDEA)
  publishAt DateTime? @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)
  publishedUrl String? @db.VarChar(1000)
  version Int @default(1)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
  project Project? @relation(fields:[projectId],references:[id],onDelete:Restrict)
  creator User @relation("ContentCreator",fields:[createdById],references:[id],onDelete:Restrict)
  owner User @relation("ContentOwner",fields:[ownerId],references:[id],onDelete:Restrict)
  publisher User? @relation("ContentPublisher",fields:[publishedById],references:[id],onDelete:Restrict)
  approvalRequest ApprovalRequest? @relation("ContentCurrentApproval",fields:[approvalRequestId],references:[id],onDelete:Restrict)
  assets ContentPostAsset[]
  revisions ContentPostRevision[]
  @@index([organizationId,publishAt,status])
  @@index([organizationId,clientId,publishAt])
  @@index([organizationId,ownerId,status])
}

model ContentPostAsset {
  postId String @db.Uuid
  assetId String @db.Uuid
  sortOrder Int @default(0)
  post ContentPost @relation(fields:[postId],references:[id],onDelete:Cascade)
  asset Asset @relation(fields:[assetId],references:[id],onDelete:Restrict)
  @@id([postId,assetId])
  @@index([assetId])
}

model ContentPostRevision {
  id String @id @default(uuid()) @db.Uuid
  postId String @db.Uuid
  revision Int
  snapshot Json
  actorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  post ContentPost @relation(fields:[postId],references:[id],onDelete:Restrict)
  @@unique([postId,revision])
  @@index([postId,createdAt])
}

// Module 13. Issued document snapshots are immutable; void only before collection.
// Money is PostgreSQL Decimal(19,4), never JS floating point during posting.
model InvoiceCounter {
 organizationId String @id @db.Uuid
 nextNumber Int @default(0)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
}

model Invoice {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 clientId String @db.Uuid
 createdById String @db.Uuid
 issuedById String? @db.Uuid
 scheduleId String? @db.Uuid
 scheduledFor DateTime? @db.Timestamptz(6)
 number String? @db.VarChar(40)
 status InvoiceStatus @default(DRAFT)
 sellerName String @db.VarChar(180)
 sellerAddress String @db.VarChar(500)
 sellerTaxId String? @db.VarChar(40)
 buyerName String @db.VarChar(180)
 buyerAddress String? @db.VarChar(500)
 currencyCode String @default("INR") @db.VarChar(3)
 issuedOn DateTime? @db.Date
 dueOn DateTime @db.Date
 subtotal Decimal @default(0) @db.Decimal(19,4)
 taxTotal Decimal @default(0) @db.Decimal(19,4)
 total Decimal @default(0) @db.Decimal(19,4)
 paidTotal Decimal @default(0) @db.Decimal(19,4)
 notes String? @db.VarChar(2000)
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
 creator User @relation("InvoiceCreator",fields:[createdById],references:[id],onDelete:Restrict)
 issuer User? @relation("InvoiceIssuer",fields:[issuedById],references:[id],onDelete:Restrict)
 schedule BillingSchedule? @relation(fields:[scheduleId],references:[id],onDelete:Restrict)
 lines InvoiceLine[]
 allocations PaymentAllocation[]
 revenueRecognitions RevenueRecognition[]
 @@unique([organizationId,number])
 @@unique([scheduleId,scheduledFor])
 @@index([organizationId,status,dueOn])
 @@index([organizationId,clientId,createdAt])
}

model InvoiceLine {
 id String @id @default(uuid()) @db.Uuid
 invoiceId String @db.Uuid
 position Int
 description String @db.VarChar(500)
 quantity Decimal @db.Decimal(12,2)
 unitPrice Decimal @db.Decimal(19,4)
 taxRate Decimal @default(0) @db.Decimal(5,2)
 net Decimal @db.Decimal(19,4)
 tax Decimal @db.Decimal(19,4)
 total Decimal @db.Decimal(19,4)
 invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
 @@unique([invoiceId,position])
}

model Payment {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 clientId String @db.Uuid
 recordedById String @db.Uuid
 verifiedById String? @db.Uuid
 ledgerEntryId String? @unique @db.Uuid
 categoryId String @db.Uuid
 idempotencyKey String @db.Uuid
 amount Decimal @db.Decimal(19,4)
 currencyCode String @default("INR") @db.VarChar(3)
 receivedOn DateTime @db.Date
 method FinanceMethod
 reference String @db.VarChar(180)
 status PaymentStatus @default(PENDING)
 verifiedAt DateTime? @db.Timestamptz(6)
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
 recorder User @relation("PaymentRecorder",fields:[recordedById],references:[id],onDelete:Restrict)
 verifier User? @relation("PaymentVerifier",fields:[verifiedById],references:[id],onDelete:Restrict)
 category FinancialCategory @relation(fields:[categoryId],references:[id],onDelete:Restrict)
 ledgerEntry FinancialTransaction? @relation("PaymentLedgerEntry",fields:[ledgerEntryId],references:[id],onDelete:Restrict)
 allocations PaymentAllocation[]
 @@unique([organizationId,idempotencyKey])
 @@unique([organizationId,method,reference])
 @@index([organizationId,status,createdAt])
 @@index([organizationId,clientId,receivedOn])
}

model PaymentAllocation {
 paymentId String @db.Uuid
 invoiceId String @db.Uuid
 amount Decimal @db.Decimal(19,4)
 payment Payment @relation(fields:[paymentId],references:[id],onDelete:Restrict)
 invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
 @@id([paymentId,invoiceId])
 @@index([invoiceId])
}

model BillingSchedule {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 clientId String @db.Uuid
 createdById String @db.Uuid
 sellerName String @db.VarChar(180)
 sellerAddress String @db.VarChar(500)
 sellerTaxId String? @db.VarChar(40)
 buyerName String @db.VarChar(180)
