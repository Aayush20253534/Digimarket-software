// Module 14: cost attribution of already-posted expense ledger entries.
model CostAllocation {
  expenseId String @db.Uuid
  clientId String @db.Uuid
  projectId String? @db.Uuid
  organizationId String @db.Uuid
  amount Decimal @db.Decimal(19,4)
  note String? @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  expense FinancialTransaction @relation(fields:[expenseId],references:[id],onDelete:Restrict)
  client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
  project Project? @relation(fields:[projectId],references:[id],onDelete:Restrict)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@id([expenseId,clientId])
  @@index([organizationId,clientId])
  @@index([projectId])
}

model RevenueRecognition {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  invoiceId String @db.Uuid
  clientId String @db.Uuid
  createdById String @db.Uuid
  idempotencyKey String @db.Uuid
  recognizedOn DateTime @db.Date
  amount Decimal @db.Decimal(19,4)
  note String @db.VarChar(500)
  reversalOfId String? @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
  client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
  creator User @relation(fields:[createdById],references:[id],onDelete:Restrict)
  reversalOf RevenueRecognition? @relation("RecognitionReversal",fields:[reversalOfId],references:[id],onDelete:Restrict)
  reversal RevenueRecognition? @relation("RecognitionReversal")
  @@unique([organizationId,idempotencyKey])
  @@index([organizationId,clientId,recognizedOn])
  @@index([invoiceId,recognizedOn])
