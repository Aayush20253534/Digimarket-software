// Module 15: organization billing configuration; existing invoice snapshots remain unchanged.
model OrganizationBillingSettings {
  organizationId String @id @db.Uuid
  invoicePrefix String @default("INV") @db.VarChar(12)
  defaultDueDays Int @default(14)
  paymentInstructions String? @db.VarChar(1000)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
}

// Module 16: private per-recipient alerts; dedupe keys make BullMQ retries idempotent.
model Notification {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  recipientId String @db.Uuid
  dedupeKey String @db.VarChar(180)
  kind String @db.VarChar(40)
  title String @db.VarChar(160)
  body String @db.VarChar(300)
  href String @db.VarChar(160)
  readAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  recipient User @relation(fields:[recipientId],references:[id],onDelete:Restrict)
  @@unique([organizationId,recipientId,dedupeKey])
  @@index([organizationId,recipientId,createdAt,id])
  @@index([organizationId,recipientId,readAt])
}

// Module 17: deployment/worker liveness, never customer data.
model ServiceHeartbeat {
  service String @id @db.VarChar(40)
  startedAt DateTime @default(now()) @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

 
// Personal workspace notes: tenant and owner isolation, CAS revision for safe autosave.
model PersonalNote {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ownerId String @db.Uuid
  title String @default("Untitled") @db.VarChar(180)
  body String @default("") @db.Text
  strokes String @default("[]") @db.Text
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  @@index([organizationId,ownerId,updatedAt,id])
}
