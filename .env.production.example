# DigiMarket production environment VARIABLE NAMES only; set actual values in host secret managers.
# Never commit tokens or provider credentials. Use separate production and staging providers.
#
# Render API
NODE_ENV=production
# Neon TLS: use sslmode=verify-full to validate certificate and hostname.
# DATABASE_URL=postgresql://user:secret@neon-pooled-host/db?sslmode=verify-full
# DIRECT_DATABASE_URL=postgresql://user:secret@neon-direct-host/db?sslmode=verify-full
# CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN
# JWT_ACCESS_SECRET=<independent 32+ byte cryptographic random value>
# JWT_CHALLENGE_SECRET=<different independent 32+ byte cryptographic random value>
# MFA_ENCRYPTION_KEY_BASE64=<base64 encoded 32 random bytes>
JWT_ISSUER=digimarket-api
JWT_AUDIENCE=digimarket-web
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# OPS_MONITOR_TOKEN=<independent 32+ byte random monitoring token>
#
# Render Worker
# DATABASE_URL=<same production pooled Neon database>
# REDIS_URL=rediss://<managed TLS redis hostname>:6379
#
# Vercel frontend: server-side ONLY, never NEXT_PUBLIC_ variables:
# API_INTERNAL_URL=https://YOUR-RENDER-API.onrender.com
# WEB_ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN
# CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN
#
# Disposable restore rehearsal operator workstation/secret runner ONLY:
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_AGE_IDENTITY_FILE=/private/path/to/age-identity.txt
# RESTORE_DATABASE_URL=postgresql://.../digimarket_restore_rehearsal?sslmode=verify-full
# RESTORE_REHEARSAL_CONFIRM=YES_RESTORE_DISPOSABLE_DB
#
# Postdeploy smoke runner:
# PROD_API_ORIGIN=https://YOUR-RENDER-API.onrender.com
# PROD_WEB_ORIGIN=https://YOUR-VERCEL-PROJECT.vercel.app

# VGraple coexistence webhook: Render API only (do not use on Vercel).
# Create a VGraple Settings > Webhooks endpoint with Message Received only.
# Save the generated secret in Render; never paste it into GitHub or chat.
# VGRAPLE_WEBHOOK_SECRET=whsec_<the endpoint's actual signing secret>
# VGRAPLE_ORGANIZATION_ID=<AmplifyWorld workspace UUID>
# VGRAPLE_CREATED_BY_USER_ID=<active founder user UUID>
# The two UUIDs can fall back to WHATSAPP_ORGANIZATION_ID and
# WHATSAPP_CREATED_BY_USER_ID if the same workspace/user is used.

# ChatGPT private MCP OAuth integration (exact HTTPS origins; no trailing path):
# CHATGPT_API_ORIGIN=https://YOUR-RENDER-API.onrender.com
# CHATGPT_WEB_ORIGIN=https://YOUR-VERCEL-FRONTEND.vercel.app
