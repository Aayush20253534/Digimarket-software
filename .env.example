# Template only. Never commit real API keys, credentials or tokens.
# Module 1 works without Neon/Redis/Cloudinary. Modules 2+ will connect them.
NODE_ENV=development
PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DATABASE_URL=postgresql://user:password@pooler-host/db?sslmode=require
# DIRECT_DATABASE_URL=postgresql://user:password@direct-host/db?sslmode=require
# REDIS_URL=redis://127.0.0.1:6379
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_ACCESS_SECRET_OR_PRIVATE_KEY=
# JWT_REFRESH_SECRET=

# Module 3: set with host-managed secrets before mounting identity APIs
# JWT_ACCESS_SECRET=at-least-32-random-bytes
# JWT_CHALLENGE_SECRET=another-independent-32+-byte-secret
# MFA_ENCRYPTION_KEY_BASE64=base64-of-32-random-bytes
